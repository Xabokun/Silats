{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kampus/silats",
    "type": "project",
    "description": "SILATS - Sistem Informasi Laboratorium Teknik Sipil: praktikum, pengujian material, dan persuratan berjenjang.",
    "keywords": ["laravel", "silats", "teknik-sipil", "laboratorium", "praktikum"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/tinker": "^2.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""],
        "post-create-project-cmd": ["@php artisan key:generate --ansi"]
    },
    "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
